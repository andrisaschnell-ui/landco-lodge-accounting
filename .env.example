# LANACC environment example.
#
# Two layers of config:
#   1. .env          — auto-managed by Lovable, holds VITE_* publishable values.
#                      Safe to commit (anon key only).
#   2. .env.local    — YOU create this on every machine. Holds real secrets.
#                      NEVER commit. Loaded by `docker compose --env-file .env.local`.
#
# Copy this file to `.env.local` and fill in real values.

# --- Frontend (Vite, public) ---
VITE_SUPABASE_PROJECT_ID="yllodlsdldtttkftalwc"
VITE_SUPABASE_URL="https://yllodlsdldtttkftalwc.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InlsbG9kbHNkbGR0dHRrZnRhbHdjIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzU5NDA3NzIsImV4cCI6MjA5MTUxNjc3Mn0._LVfaD5cRTOVeJEgnWGmaBME9GvmdzSN8_5eh1W63qA"

# Optional: bake API URL for LAN access from other PCs (e.g. http://192.168.1.10:4000)
# VITE_API_URL=http://localhost:4000

# =====================================================================
# SECRETS — required in .env.local, NEVER commit real values
# =====================================================================

# Local Postgres password (used by db service AND DATABASE_URL)
POSTGRES_PASSWORD=CHANGE_ME_strong_password

# Local API auth — sign JWT tokens issued by /auth/login
JWT_SECRET=CHANGE_ME_random_64_chars

# Local invoice/AT signing key
AT_SIGNING_KEY=CHANGE_ME_random_64_chars

# pgAdmin login (only needed if you use the pgAdmin UI on :5050)
PGADMIN_PASSWORD=CHANGE_ME_pgadmin_password

# Required for "Push Local → Cloud" + "Pull Cloud → Local".
# Get it from Lovable → Cloud → Backend → API keys → service_role.
# Belongs to project yllodlsdldtttkftalwc only.
SUPABASE_SERVICE_ROLE_KEY=
