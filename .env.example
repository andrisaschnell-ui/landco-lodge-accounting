# LANACC environment example.
#
# Two layers of config:
#   1. .env          — auto-managed by Lovable, holds VITE_* publishable values.
#                      Safe to commit (anon key only).
#   2. .env.local    — YOU create this on every machine. Holds real secrets.
#                      NEVER commit. Loaded by `docker compose --env-file .env.local`.
#
# Copy this file to `.env.local` and fill in real values.

# --- Frontend (Vite, public) ---
VITE_SUPABASE_PROJECT_ID="neakxehuonsrlvjrxhnd"
VITE_SUPABASE_URL="https://neakxehuonsrlvjrxhnd.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im5lYWt4ZWh1b25zcmx2anJ4aG5kIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzczODcyMzUsImV4cCI6MjA5Mjk2MzIzNX0.m9cL7bDv5jRFjBqmzxOYLus36ptEoY-BVdY7ohncMhg"

# Optional: bake API URL for LAN access from other PCs (e.g. http://192.168.1.10:4000)
# VITE_API_URL=http://localhost:4000

# =====================================================================
# SECRETS — required in .env.local, NEVER commit real values
# =====================================================================

# Local Postgres password (used by db service AND DATABASE_URL)
POSTGRES_PASSWORD=CHANGE_ME_strong_password

# Local API auth — sign JWT tokens issued by /auth/login
JWT_SECRET=CHANGE_ME_random_64_chars

# Local invoice/AT signing key
AT_SIGNING_KEY=CHANGE_ME_random_64_chars

# pgAdmin login (only needed if you use the pgAdmin UI on :5050)
PGADMIN_PASSWORD=CHANGE_ME_pgadmin_password

# Required for "Push Local → Cloud" + "Pull Cloud → Local".
# Get it from Supabase project → Settings → API → service_role.
# Belongs to project neakxehuonsrlvjrxhnd only.
SUPABASE_SERVICE_ROLE_KEY=

# PIN that gates the in-app admin signup form AND the make-admin script.
# Anyone who knows this PIN can create an admin user on this machine.
# MUST match the ADMIN_SIGNUP_PIN secret configured in cloud (Lovable Cloud → Secrets).
ADMIN_SIGNUP_PIN=Abcd7654$#
